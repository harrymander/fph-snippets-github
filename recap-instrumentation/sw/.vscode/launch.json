{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with OpenOCD",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/recap-instrumentation.elf",
            "request": "launch",
            "servertype": "openocd",
            "configFiles": [
                "${workspaceFolder}/mat91lib/sam4s/scripts/sam4s_stlink.cfg"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
            "rtos": "auto",
            "linux": {
                "gdbPath": "gdb-multiarch"
            }
        }
    ]
}
